# Copy this file to `.env` in the same folder (app/) and fill in real values.
# .env is read by scripts/new/abronal_scraper.py via python-dotenv.
# NEVER commit the real .env file — it holds login credentials.

BASE_URL=https://your-abronal-ehealth-domain.example.com
USERNAME=your_abronal_username
PASSWORD=your_abronal_password
ROLE=Cardiologist Coordinator

# Optional but recommended: encrypt USERNAME/PASSWORD at rest so a
# leaked or accidentally-committed .env doesn't hand over plaintext
# credentials. After filling in the real values above, run:
#
#   python security/crypto.py --generate-key   (one-time; creates .encryption_key)
#   python security/crypto.py --encrypt-env    (rewrites USERNAME/PASSWORD in place)
#
# This replaces USERNAME=... / PASSWORD=... above with an
# "enc:"-prefixed encrypted value; the app decrypts it automatically
# at runtime using .encryption_key (or the ENCRYPTION_KEY env var, if
# you'd rather supply the key that way, e.g. from Docker/a secrets
# manager instead of a file on disk). Keep .encryption_key itself out
# of version control, same as .env.
